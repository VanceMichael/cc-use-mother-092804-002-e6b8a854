{
  "title": "元青花文物主题发行档案",
  "type": "object",
  "required": [
    "domain",
    "version",
    "institutions",
    "artifacts",
    "licenses",
    "designs",
    "materials",
    "batches",
    "receipts",
    "holds",
    "reviews"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "const": "yuan-porcelain-stamp"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "institutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/institution"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/license"
      }
    },
    "designs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/design"
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/batch"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hold"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "institution": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "name",
        "institution_id",
        "provenance",
        "decoration",
        "visibility"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "institution_id": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "required": [
            "kind",
            "detail"
          ],
          "properties": {
            "kind": {
              "enum": [
                "出土",
                "传世"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "decoration": {
          "type": "string"
        },
        "visibility": {
          "enum": [
            "公开",
            "内部"
          ]
        },
        "internal_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": [
        "id",
        "artifact_id",
        "granted_by",
        "scope",
        "valid_from",
        "valid_until",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "granted_by": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "邮票",
              "小型张",
              "首日封",
              "宣传册"
            ]
          }
        },
        "valid_from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "valid_until": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "enum": [
            "有效",
            "到期",
            "撤销"
          ]
        }
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "required": [
        "id",
        "artifact_id",
        "version",
        "license_id",
        "decoration",
        "status",
        "history"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "license_id": {
          "type": "string"
        },
        "decoration": {
          "type": "string"
        },
        "status": {
          "enum": [
            "草稿",
            "待审",
            "已批准",
            "驳回"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approval"
          }
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "version",
        "decision",
        "by",
        "at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "uses",
        "frozen"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "邮票",
            "小型张",
            "首日封",
            "宣传册"
          ]
        },
        "title": {
          "type": "string"
        },
        "uses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "frozen": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "required": [
        "id",
        "material_id",
        "process",
        "quantity",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "material_id": {
          "type": "string"
        },
        "process": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "计划中",
            "印制中",
            "暂停",
            "已完成"
          ]
        },
        "completed_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "basis": {
          "type": "object",
          "required": [
            "uses"
          ],
          "properties": {
            "uses": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/basisUse"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "basisUse": {
      "type": "object",
      "required": [
        "design_id",
        "version",
        "license_id"
      ],
      "properties": {
        "design_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "license_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "id",
        "batch_id",
        "quantity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "batch_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "hold": {
      "type": "object",
      "required": [
        "id",
        "stage",
        "reason",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "设计",
            "审批",
            "印制",
            "发行"
          ]
        },
        "reason": {
          "enum": [
            "图像更正",
            "授权到期",
            "批次异常"
          ]
        },
        "status": {
          "enum": [
            "未解除",
            "已解除"
          ]
        },
        "artifact_id": {
          "type": "string"
        },
        "license_id": {
          "type": "string"
        },
        "batch_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "status": {
          "enum": [
            "待复核",
            "复核中",
            "已解决"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
